  "nodes": [
    {
      "id": "vertex",
      "type": "textDAT",
      "position": [
        -450,
        350
      ],
      "purpose": "GLSL MAT vertex shader",
      "source": "liquid_glass_lit.vert"
    },
    {
      "id": "pixel",
      "type": "textDAT",
      "position": [
        -250,
        350
      ],
      "purpose": "GLSL MAT pixel shader",
      "source": "liquid_glass_lit.frag"
    },
    {
      "id": "material",
      "type": "glslMAT",
      "position": [
        0,
        350
      ],
      "purpose": "THE lit liquid glass material: assign it to any Geometry COMP in a lit scene",
      "parameters": {
        "glslversion": "glsl460",
        "lightingspace": "worldspace",
        "blending": true,
        "srcblend": "one",
        "destblend": "omsa",
        "separatealphafunc": false,
        "postmultalpha": false,
        "depthtest": true,
        "depthwriting": true
      },
      "expressions": {
        "cullface": "'backfaces' if parent().par.Culling.eval() == 'back' else 'neither'"
      },
      "uniforms": [
        {
          "name": "uGlass",
          "values": [
            "op('presets').module.u(parent().par.Glasscolorr)",
            "op('presets').module.u(parent().par.Glasscolorg)",
            "op('presets').module.u(parent().par.Glasscolorb)",
            "op('presets').module.u(parent().par.Density)"
          ]
        },
        {
          "name": "uBody",
          "values": [
            "op('presets').module.u(parent().par.Translucency)",
            "op('presets').module.u(parent().par.Frost)",
            "op('presets').module.u(parent().par.Opacity)",
            "op('presets').module.u(parent().par.Edgetint)"
          ]
        },
        {
          "name": "uOptics",
          "values": [
            "op('presets').module.u(parent().par.Ior)",
            "op('presets').module.u(parent().par.Thickness)",
            "op('presets').module.u(parent().par.Dispersion)",
            "op('presets').module.u(parent().par.Saturation)"
          ]
        },
        {
          "name": "uReflect",
          "values": [
            "op('presets').module.u(parent().par.Reflectcolorr)",
            "op('presets').module.u(parent().par.Reflectcolorg)",
            "op('presets').module.u(parent().par.Reflectcolorb)",
            "op('presets').module.u(parent().par.Reflection)"
          ]
        },
        {
          "name": "uSurface",
          "values": [
            "op('presets').module.u(parent().par.Mirror)",
            "op('presets').module.u(parent().par.Fresnelpower)",
            "op('presets').module.u(parent().par.Roughness)",
            "op('presets').module.u(parent().par.Highlightsize)"
          ]
        },
        {
          "name": "uRim",
          "values": [
            "op('presets').module.u(parent().par.Rimcolorr)",
            "op('presets').module.u(parent().par.Rimcolorg)",
            "op('presets').module.u(parent().par.Rimcolorb)",
            "op('presets').module.u(parent().par.Rim)"
          ]
        },
        {
          "name": "uShade",
          "values": [
            "op('presets').module.u(parent().par.Specular)",
            "op('presets').module.u(parent().par.Diffuse)",
            "op('presets').module.u(parent().par.Ambient)",
            "parent().par.Shadowstrength"
          ]
        },
        {
          "name": "uSources",
          "values": [
            "parent().par.Lightsource.menuIndex",
            "parent().par.Envsource.menuIndex",
            "parent().par.Envintensity",
            "parent().par.Envmips"
          ]
        },
        {
          "name": "uKey",
          "values": [
            "parent().par.Keydirx",
            "parent().par.Keydiry",
            "parent().par.Keydirz",
            "parent().par.Keyintensity"
          ]
        },
        {
          "name": "uKeyColor",
          "values": [
            "parent().par.Keycolorr",
            "parent().par.Keycolorg",
            "parent().par.Keycolorb",
            "parent().par.Studiorotate * 0.0174533"
          ]
        },
        {
          "name": "uFilm",
          "values": [
            "op('presets').module.u(parent().par.Iridescence)",
            "op('presets').module.u(parent().par.Filmthickness)",
            "op('presets').module.u(parent().par.Filmvariation)",
            0
          ]
        },
        {
          "name": "uWobble",
          "values": [
            "op('presets').module.u(parent().par.Wobble)",
            "op('presets').module.u(parent().par.Wobblescale)",
            "op('presets').module.u(parent().par.Wobblespeed)",
            "parent().par.Time if parent().par.Pause.eval() else absTime.seconds"
          ]
        },
        {
          "name": "uState",
          "values": [
            "parent().par.Stage.menuIndex",
            "parent().par.Samples",
            "1 if parent().par.Flipv.eval() else 0",
            "1 if parent().par.Refractiontop.eval() else 0"
          ]
