  "nodes": [
    {
      "id": "vertex",
      "type": "textDAT",
      "position": [
        -450,
        350
      ],
      "purpose": "GLSL MAT vertex shader",
      "source": "liquid_glass.vert"
    },
    {
      "id": "pixel",
      "type": "textDAT",
      "position": [
        -250,
        350
      ],
      "purpose": "GLSL MAT pixel shader",
      "source": "liquid_glass.frag"
    },
    {
      "id": "material",
      "type": "glslMAT",
      "position": [
        0,
        350
      ],
      "purpose": "THE liquid glass material: assign it to any Geometry COMP",
      "parameters": {
        "glslversion": "glsl460",
        "blending": true,
        "srcblend": "one",
        "destblend": "omsa",
        "separatealphafunc": false,
        "postmultalpha": false,
        "depthtest": true,
        "depthwriting": true
      },
      "expressions": {
        "cullface": "'backfaces' if parent().par.Culling.eval() == 'back' else 'neither'"
      },
      "uniforms": [
        {
          "name": "uGlass",
          "values": [
            "op('presets').module.u(parent().par.Glasscolorr)",
            "op('presets').module.u(parent().par.Glasscolorg)",
            "op('presets').module.u(parent().par.Glasscolorb)",
            "op('presets').module.u(parent().par.Density) / parent().par.Objectsize.eval()"
          ]
        },
        {
          "name": "uBody",
          "values": [
            "op('presets').module.u(parent().par.Translucency)",
            "op('presets').module.u(parent().par.Frost) * parent().par.Objectsize.eval()",
            "op('presets').module.u(parent().par.Opacity)",
            "op('presets').module.u(parent().par.Edgetint)"
          ]
        },
        {
          "name": "uOptics",
          "values": [
            "op('presets').module.u(parent().par.Ior)",
            "op('presets').module.u(parent().par.Thickness) * parent().par.Objectsize.eval()",
            "op('presets').module.u(parent().par.Dispersion)",
            "op('presets').module.u(parent().par.Saturation)"
          ]
        },
        {
          "name": "uReflect",
          "values": [
            "op('presets').module.u(parent().par.Reflectcolorr)",
            "op('presets').module.u(parent().par.Reflectcolorg)",
            "op('presets').module.u(parent().par.Reflectcolorb)",
            "op('presets').module.u(parent().par.Reflection)"
          ]
        },
        {
          "name": "uEnv",
          "values": [
            "op('presets').module.menu(parent().par.Reflectmode)",
            "parent().par.Envrotate * 0.0174533",
            "op('presets').module.u(parent().par.Reflectblur)",
            "parent().par.Screenwarp"
          ]
        },
        {
          "name": "uSurface",
          "values": [
            "op('presets').module.u(parent().par.Mirror)",
            "op('presets').module.u(parent().par.Fresnelpower)",
            "op('presets').module.u(parent().par.Diffuse)",
            "1 if parent().par.Conserve.eval() else 0"
          ]
        },
        {
          "name": "uRim",
          "values": [
            "op('presets').module.u(parent().par.Rimcolorr)",
            "op('presets').module.u(parent().par.Rimcolorg)",
            "op('presets').module.u(parent().par.Rimcolorb)",
            "op('presets').module.u(parent().par.Rim)"
          ]
        },
        {
          "name": "uLight",
          "values": [
            "parent().par.Lightdirx",
            "parent().par.Lightdiry",
            "parent().par.Lightdirz",
            "op('presets').module.u(parent().par.Specular)"
          ]
        },
        {
          "name": "uLightColor",
          "values": [
            "op('presets').module.u(parent().par.Lightcolorr)",
            "op('presets').module.u(parent().par.Lightcolorg)",
            "op('presets').module.u(parent().par.Lightcolorb)",
            "op('presets').module.u(parent().par.Shininess)"
          ]
        },
        {
          "name": "uFilm",
          "values": [
            "op('presets').module.u(parent().par.Iridescence)",
            "op('presets').module.u(parent().par.Filmthickness)",
            "op('presets').module.u(parent().par.Filmvariation)",
            "2.5 / parent().par.Objectsize.eval()"
          ]
        },
        {
          "name": "uWobble",
          "values": [
            "op('presets').module.u(parent().par.Wobble)",
            "op('presets').module.u(parent().par.Wobblescale) / parent().par.Objectsize.eval()",
            "op('presets').module.u(parent().par.Wobblespeed)",
            0
          ]
        },
        {
          "name": "uPhase",
          "values": [
            "op('presets').module.phase(parent(), 0.6)",
            "op('presets').module.phase(parent(), 0.4)",
            "op('presets').module.phase(parent(), -0.3)",
            "op('presets').module.phase(parent(), 0.15)"
          ]
        },
        {
          "name": "uState",
          "values": [
            "op('presets').module.menu(parent().par.Stage)",
            0,
